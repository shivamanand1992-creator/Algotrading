# Copy this to .env and fill in your credentials

# Angel One Broker API
ANGEL_API_KEY=your_angel_one_api_key
ANGEL_CLIENT_CODE=your_client_code
ANGEL_PASSWORD=your_trading_password
ANGEL_TOTP_SECRET=your_totp_secret_key

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email Notifications (optional)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=alerts@yourmail.com

# Anthropic Claude API (REQUIRED for Hermes AI agent)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
